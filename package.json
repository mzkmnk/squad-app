{
  "name": "squad-app",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "electron:build": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "electron:serve": "pnpm electron:build && electron .",
    "package": "pnpm build && pnpm electron:build && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"electron/**/*.ts\" \"*.{json,md,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"electron/**/*.ts\" \"*.{json,md,js,mjs}\"",
    "test": "pnpm test:ng && pnpm test:electron",
    "test:ng": "ng test --no-watch",
    "test:electron": "pnpm exec vitest run electron/ --exclude 'dist-electron/**'",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "electron/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ],
    "*.{json,md,js,mjs}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@ng-icons/core": "^31.4.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "0.0.1-alpha.630",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "ngx-sonner": ">=3.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@spartan-ng/cli": "0.0.1-alpha.630",
    "angular-eslint": "^21.2.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
